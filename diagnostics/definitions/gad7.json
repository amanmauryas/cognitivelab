{
    "id": "gad7",
    "name": "GAD-7",
    "title": "Generalized Anxiety Disorder 7-item Scale",
    "version": "1.0",
    "type": "diagnostic_scale",
    "category": "Anxiety symptoms",
    "description": "A 7-item screening tool and symptom severity measure for generalized anxiety disorder.",
    "instructions": {
        "text": "Over the last 2 weeks, how often have you been bothered by the following problems?",
        "timeframe": "past_2_weeks"
    },
    "response_scale": [
        {
            "value": 0,
            "label": "Not at all"
        },
        {
            "value": 1,
            "label": "Several days"
        },
        {
            "value": 2,
            "label": "More than half the days"
        },
        {
            "value": 3,
            "label": "Nearly every day"
        }
    ],
    "questions": [
        {
            "id": "gad7_01",
            "number": 1,
            "text": "Feeling nervous, anxious, or on edge",
            "response_type": "single_choice"
        },
        {
            "id": "gad7_02",
            "number": 2,
            "text": "Not being able to stop or control worrying",
            "response_type": "single_choice"
        },
        {
            "id": "gad7_03",
            "number": 3,
            "text": "Worrying too much about different things",
            "response_type": "single_choice"
        },
        {
            "id": "gad7_04",
            "number": 4,
            "text": "Trouble relaxing",
            "response_type": "single_choice"
        },
        {
            "id": "gad7_05",
            "number": 5,
            "text": "Being so restless that it's hard to sit still",
            "response_type": "single_choice"
        },
        {
            "id": "gad7_06",
            "number": 6,
            "text": "Becoming easily annoyed or irritable",
            "response_type": "single_choice"
        },
        {
            "id": "gad7_07",
            "number": 7,
            "text": "Feeling afraid, as if something awful might happen",
            "response_type": "single_choice"
        }
    ],
    "scoring": {
        "method": "sum",
        "min_score": 0,
        "max_score": 21,
        "interpretation": [
            {
                "min": 0,
                "max": 4,
                "label": "Minimal anxiety"
            },
            {
                "min": 5,
                "max": 9,
                "label": "Mild anxiety"
            },
            {
                "min": 10,
                "max": 14,
                "label": "Moderate anxiety"
            },
            {
                "min": 15,
                "max": 21,
                "label": "Severe anxiety"
            }
        ]
    },
    "report": {
        "title": "GAD-7 Assessment Report",
        "include": [
            "total_score",
            "response_summary",
            "interpretation"
        ]
    }
}
